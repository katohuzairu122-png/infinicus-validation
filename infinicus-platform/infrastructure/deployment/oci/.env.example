# Phase 3 — copy this to `.env` in this same directory (infrastructure/
# deployment/oci/) on the OCI VM and fill in real values. docker compose
# reads .env automatically from the directory it's invoked from — never
# commit the real .env (it's covered by the repo's root .gitignore
# pattern for .env; double-check with `git status` before any commit
# from this directory regardless).
#
# See the repo root's .env.example / packages/configuration/src/secrets.ts
# for what every one of these actually controls server-side.

# ── Database — generate real random values, e.g. `openssl rand -base64 24` ──
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=

# ── HTTP ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://infini-cus.com,https://www.infini-cus.com

# ── Email (optional — unset means verification emails are logged, not
# sent; never blocks registration) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=INFINICUS <noreply@infini-cus.com>
EMAIL_VERIFICATION_URL_BASE=https://infini-cus.com/verify-email

# ── Observability ────────────────────────────────────────────────────
LOG_LEVEL=info
